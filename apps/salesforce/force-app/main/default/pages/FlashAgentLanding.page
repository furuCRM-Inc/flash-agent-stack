<script>
// ── Tab switcher ──────────────────────────────────────────────────
function switchTab(id) {
  document.querySelectorAll('.tab').forEach(function(t,i){
    var ids = ['cf','sf','local'];
    t.classList.toggle('active', ids[i] === id);
  });
  document.querySelectorAll('.tab-content').forEach(function(c){
    c.classList.remove('active');
  });
  var el = document.getElementById('tab-'+id);
  if (el) el.classList.add('active');
}

// ── Copy code ─────────────────────────────────────────────────────
function copyPre(id) {
  var el = document.getElementById(id);
  if (!el || !navigator.clipboard) return;
  navigator.clipboard.writeText(el.innerText).then(function(){
    var btn = el.closest('.code-card').querySelector('.copy-btn');
    btn.textContent = 'copied!';
    btn.style.color = 'var(--green)';
    setTimeout(function(){ btn.textContent = 'copy'; btn.style.color = ''; }, 2000);
  });
}

// ── Terminal demo animation ───────────────────────────────────────
var demoRunning = false;

var CHAT_MSG = 'System down. Lost $50,000. Cancel my subscription and refund me NOW!';

var JSON_LINES = [
  '// POST /v1/systemone → 50ms',
  '{',
  '  "answers": {',
  '    "is_critical": {',
  '      "type": "noul",',
  '      "noul": 0.97',
  '    },',
  '    "recommended_action": {',
  '      "type": "choice",',
  '      "choice": "APPROVE_MAX_REFUND",',
  '      "confidence": 0.95',
  '    },',
  '    "urgency_level": {',
  '      "type": "score",',
  '      "score": 2.85,',
  '      "confidence": 0.92',
  '    }',
  '  },',
  '  "usage": { "output_tokens": 0 }',
  '}'
];

function wait(ms) {
  return new Promise(function(r){ setTimeout(r, ms); });
}

async function runDemoAnim() {
  if (demoRunning) return;
  demoRunning = true;
  var btn = document.getElementById('demoRunBtn');
  btn.disabled = true;

  // Reset all
  document.getElementById('chatText').textContent = '';
  document.getElementById('chatCursor').style.display = 'inline';
  document.getElementById('chatTag').classList.add('chat-hidden');
  document.getElementById('jsonOutput').style.opacity = '0';
  document.getElementById('jsonOutput').innerHTML = '';
  document.getElementById('latencyTag').classList.remove('show');
  document.getElementById('sfBtn').className = 'sf-btn sf-btn--default';
  document.getElementById('sfBtn').style.display = 'flex';
  document.getElementById('resolvedBadge').classList.remove('show');
  document.getElementById('progressFill').style.width = '0';

  // Phase 1: typewriter chat message
  var chatEl = document.getElementById('chatText');
  for (var i = 0; i < CHAT_MSG.length; i++) {
    chatEl.textContent += CHAT_MSG[i];
    await wait(14);
  }
  document.getElementById('chatCursor').style.display = 'none';
  document.getElementById('chatTag').classList.remove('chat-hidden');
  document.getElementById('progressFill').style.width = '20%';
  await wait(400);

  // Phase 2: JSON output appears line by line
  var jsonEl = document.getElementById('jsonOutput');
  jsonEl.style.opacity = '1';
  jsonEl.innerHTML = '';
  for (var j = 0; j < JSON_LINES.length; j++) {
    var line = JSON_LINES[j];
    var colored = line
      .replace(/"([^"]+)":/g, '<span class="ce">"$1"</span>:')
      .replace(/: "([^"]+)"/g, ': <span class="cs">"$1"</span>')
      .replace(/: ([\d.]+)/g, ': <span class="jn">$1</span>')
      .replace(/^(\s*\/\/.*)/g, '<span class="cm">$1</span>');
    jsonEl.innerHTML += colored + '\n';
    await wait(60);
  }
  document.getElementById('progressFill').style.width = '55%';
  await wait(200);
  document.getElementById('latencyTag').classList.add('show');
  await wait(600);

  // Phase 3: WebMCP pulsing button
  var sfBtn = document.getElementById('sfBtn');
  sfBtn.className = 'sf-btn sf-btn--pulse';
  sfBtn.textContent = '⚡ WebMCP → approve_refund()';
  document.getElementById('progressFill').style.width = '80%';
  await wait(900);

  // Phase 4: Done
  sfBtn.style.display = 'none';
  document.getElementById('resolvedBadge').classList.add('show');
  document.getElementById('progressFill').style.width = '100%';
  await wait(300);

  demoRunning = false;
  btn.disabled = false;
  btn.textContent = '↺ Run Again';
}

// Auto-play on load after short delay
setTimeout(runDemoAnim, 1200);
</script>
</body>
