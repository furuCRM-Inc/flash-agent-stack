<meta property="og:title" content="⚡ FlashAgent Stack — 10ms System 1 AI for Salesforce"/>
<meta property="og:description" content="Stop waiting for heavy LLMs. Resolve $50K VIP crises in 400ms with System 1 reflexes + WebMCP native UI control."/>
