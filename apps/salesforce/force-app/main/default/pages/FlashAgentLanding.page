<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#0B0F19;--s1:#111827;--s2:#1E293B;--s3:#273344;
  --border:#2D3748;--border2:#374151;
  --electric:#06B6D4;--amber:#F59E0B;--green:#10B981;
  --red:#EF4444;--purple:#8B5CF6;--rose:#F43F5E;
  --text:#F1F5F9;--dim:#94A3B8;--dim2:#64748B;
  --mono:'SF Mono','Fira Code','Cascadia Code','Courier New',monospace;
  --sans:-apple-system,BlinkMacSystemFont,'Inter','Segoe UI',sans-serif;
}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--text);font-family:var(--sans);line-height:1.6;min-height:100vh;-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration:none}
/* NAV */
nav{position:sticky;top:0;z-index:100;background:rgba(11,15,25,.85);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border-bottom:1px solid var(--border);height:60px;display:flex;align-items:center;padding:0 40px;gap:32px}
.nav-logo{font-family:var(--mono);font-size:17px;font-weight:700;color:var(--electric);letter-spacing:-.3px}
.nav-links{display:flex;gap:28px;margin-left:auto;align-items:center}
.nav-links a{font-size:14px;color:var(--dim);transition:color .2s}.nav-links a:hover{color:var(--text)}
.nav-gh{background:var(--s2);border:1px solid var(--border2);border-radius:8px;padding:6px 16px;font-size:13px;font-weight:600;color:var(--text);transition:border-color .2s}.nav-gh:hover{border-color:var(--electric)}
.nav-cta{background:linear-gradient(135deg,var(--electric),var(--purple));color:#fff;border-radius:8px;padding:7px 18px;font-size:13px;font-weight:700;transition:opacity .2s}.nav-cta:hover{opacity:.85}
/* HERO */
.hero{text-align:center;padding:110px 24px 90px;position:relative;overflow:hidden}
.hero::before{content:'';position:absolute;top:-200px;left:50%;transform:translateX(-50%);width:900px;height:900px;background:radial-gradient(ellipse at center,rgba(6,182,212,.12) 0%,rgba(139,92,246,.08) 40%,transparent 70%);pointer-events:none}
.hero-eyebrow{display:inline-flex;align-items:center;gap:8px;background:rgba(6,182,212,.08);border:1px solid rgba(6,182,212,.25);border-radius:20px;padding:5px 16px;font-size:12px;font-weight:600;letter-spacing:.8px;text-transform:uppercase;color:var(--electric);margin-bottom:28px}
.hero h1{font-size:clamp(38px,7vw,76px);font-weight:900;letter-spacing:-2.5px;line-height:1.05;margin-bottom:20px;position:relative}
.hero h1 .grad{background:linear-gradient(135deg,var(--electric) 0%,var(--purple) 50%,var(--amber) 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.hero-sub{font-size:clamp(16px,2.5vw,20px);color:var(--dim);max-width:680px;margin:0 auto 40px;line-height:1.7}
.hero-sub strong{color:var(--text)}
.hero-btns{display:flex;justify-content:center;gap:14px;flex-wrap:wrap;margin-bottom:56px}
.btn-primary{display:inline-flex;align-items:center;gap:8px;background:linear-gradient(135deg,var(--electric),var(--purple));color:#fff;border:none;border-radius:12px;padding:15px 32px;font-size:16px;font-weight:700;cursor:pointer;transition:opacity .2s,transform .1s;font-family:inherit}.btn-primary:hover{opacity:.88;transform:translateY(-1px)}
.btn-outline{display:inline-flex;align-items:center;gap:8px;background:transparent;color:var(--text);border:1px solid var(--border2);border-radius:12px;padding:14px 30px;font-size:16px;cursor:pointer;transition:border-color .2s;font-family:inherit}.btn-outline:hover{border-color:var(--dim)}
.hero-stats{display:inline-flex;gap:0;border:1px solid var(--border);border-radius:14px;overflow:hidden;background:var(--s1)}
.hs{padding:18px 32px;text-align:center;border-right:1px solid var(--border)}.hs:last-child{border-right:none}
.hs-num{font-size:28px;font-weight:800;font-family:var(--mono);display:block}
.hs-num--c{color:var(--electric)}.hs-num--a{color:var(--amber)}.hs-num--g{color:var(--green)}.hs-num--p{color:var(--purple)}
.hs-lbl{font-size:11px;color:var(--dim2);margin-top:3px;letter-spacing:.3px}
/* TERMINAL DEMO */
.demo-section{padding:80px 40px;max-width:1280px;margin:0 auto}
.section-eyebrow{font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--electric);margin-bottom:12px}
.section-h2{font-size:clamp(28px,4.5vw,44px);font-weight:800;letter-spacing:-1px;margin-bottom:14px}
.section-sub{font-size:17px;color:var(--dim);max-width:680px;margin-bottom:52px;line-height:1.7}
.terminal-stage{display:grid;grid-template-columns:1fr 1.1fr 1fr;gap:16px;margin-bottom:28px;align-items:start}
.win{background:var(--s1);border:1px solid var(--border);border-radius:14px;overflow:hidden}
.win-bar{background:var(--s2);border-bottom:1px solid var(--border);padding:10px 14px;display:flex;align-items:center;gap:6px}
.wd{width:10px;height:10px;border-radius:50%}
.wd-r{background:#FF5F57}.wd-a{background:#FFBD2E}.wd-g{background:#28C840}
.win-title{font-family:var(--mono);font-size:11px;color:var(--dim2);margin-left:6px;letter-spacing:.3px}
.win-body{padding:16px}
/* Chat window */
.chat-vip-label{font-size:11px;color:var(--rose);font-weight:700;letter-spacing:.5px;margin-bottom:10px;display:flex;align-items:center;gap:6px}
.vip-dot{width:7px;height:7px;border-radius:50%;background:var(--rose);animation:blink 1s infinite}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.2}}
.chat-bubble{background:rgba(239,68,68,.07);border:1px solid rgba(239,68,68,.2);border-radius:10px;padding:12px 14px;font-size:13px;line-height:1.65;color:var(--text);min-height:70px;position:relative}
.cursor-blink{animation:cur .6s step-end infinite;color:var(--electric)}
@keyframes cur{0%,100%{opacity:1}50%{opacity:0}}
.chat-tag{display:inline-flex;align-items:center;gap:6px;background:var(--rose);color:#fff;font-size:10px;font-weight:700;letter-spacing:1px;border-radius:4px;padding:3px 9px;margin-top:10px}
.chat-hidden{display:none}
/* JSON window */
.json-pre{font-family:var(--mono);font-size:11.5px;line-height:1.8;color:#94A3B8;overflow-x:auto}
.jk{color:var(--electric)}.js{color:#A5D6FF}.jn{color:var(--amber)}.jv{color:var(--green)}
.latency-tag{display:inline-flex;align-items:center;gap:6px;background:rgba(16,185,129,.12);border:1px solid rgba(16,185,129,.3);color:var(--green);font-size:12px;font-weight:700;font-family:var(--mono);border-radius:6px;padding:5px 12px;margin-top:12px;opacity:0;transition:opacity .4s}
.latency-tag.show{opacity:1}
/* Salesforce window */
.sf-header{background:rgba(6,182,212,.06);border-bottom:1px solid rgba(6,182,212,.15);padding:10px 14px;font-size:12px;color:var(--electric);font-weight:600}
.sf-case{background:var(--s2);border-radius:8px;padding:12px;margin-bottom:12px}
.sf-case-label{font-size:10px;color:var(--dim2);margin-bottom:4px;text-transform:uppercase;letter-spacing:.5px}
.sf-case-value{font-size:13px;color:var(--text);font-weight:500}
.sf-btn{display:flex;align-items:center;justify-content:center;gap:8px;width:100%;padding:11px;border-radius:8px;font-size:14px;font-weight:700;border:none;cursor:pointer;transition:all .3s;font-family:inherit}
.sf-btn--default{background:rgba(6,182,212,.12);border:1px solid rgba(6,182,212,.3);color:var(--electric)}
.sf-btn--pulse{animation:pulse-btn 0.5s ease-in-out infinite alternate;background:rgba(245,158,11,.12);border-color:rgba(245,158,11,.5);color:var(--amber)}
@keyframes pulse-btn{from{box-shadow:0 0 0 0 rgba(245,158,11,.4)}to{box-shadow:0 0 14px 4px rgba(245,158,11,.2)}}
.sf-btn--done{background:rgba(16,185,129,.15);border-color:rgba(16,185,129,.4);color:var(--green)}
.resolved-badge{display:none;text-align:center;padding:16px 8px;animation:pop .4s cubic-bezier(.34,1.56,.64,1)}
@keyframes pop{from{transform:scale(.5);opacity:0}to{transform:scale(1);opacity:1}}
.resolved-badge.show{display:block}
.resolved-icon{font-size:36px;display:block;margin-bottom:8px}
.resolved-num{font-size:22px;font-weight:800;font-family:var(--mono);color:var(--green)}
.resolved-lbl{font-size:11px;color:var(--dim);margin-top:4px}
/* Progress bar */
.progress-bar{height:3px;background:var(--border);border-radius:2px;overflow:hidden;margin-top:20px}
.progress-fill{height:100%;background:linear-gradient(90deg,var(--electric),var(--purple),var(--amber));border-radius:2px;width:0;transition:width .4s ease}
/* FEATURES */
.features{padding:80px 40px;max-width:1280px;margin:0 auto}
.feature-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:16px}
.feat-card{background:var(--s1);border:1px solid var(--border);border-radius:14px;padding:26px;transition:border-color .2s,transform .2s}
.feat-card:hover{border-color:rgba(6,182,212,.4);transform:translateY(-2px)}
.feat-icon{font-size:32px;margin-bottom:16px;display:block}
.feat-card h3{font-size:18px;font-weight:700;margin-bottom:8px}
.feat-card p{font-size:14px;color:var(--dim);line-height:1.7}
.feat-tag{display:inline-block;background:rgba(6,182,212,.08);border:1px solid rgba(6,182,212,.2);color:var(--electric);font-size:11px;font-weight:600;border-radius:6px;padding:3px 10px;margin-top:12px;font-family:var(--mono)}
/* COMPARISON */
.comparison{padding:80px 40px;max-width:1280px;margin:0 auto}
.table-wrap{overflow-x:auto;border-radius:14px;border:1px solid var(--border)}
table{width:100%;border-collapse:collapse;font-size:14px}
thead tr{background:var(--s2)}
th{padding:14px 20px;text-align:left;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.8px;color:var(--dim2);border-bottom:1px solid var(--border)}
th:first-child{width:35%}
.th-free{color:var(--electric)}.th-pro{color:var(--purple)}
td{padding:13px 20px;border-bottom:1px solid var(--border);vertical-align:top;color:var(--text)}
tr:last-child td{border-bottom:none}
tr:nth-child(even) td{background:rgba(255,255,255,.02)}
.td-feat{font-weight:600;font-size:14px}
.td-check{color:var(--green);font-weight:700}
.td-x{color:var(--dim2)}
.td-price{font-family:var(--mono);font-size:16px;font-weight:800;color:var(--electric)}
.td-price-pro{font-family:var(--mono);font-size:14px;font-weight:700;color:var(--purple)}
/* HOW TO DEPLOY */
.deploy{padding:80px 40px;max-width:1280px;margin:0 auto}
.deploy-tabs{display:flex;gap:6px;margin-bottom:28px;background:var(--s2);border:1px solid var(--border);border-radius:10px;padding:5px;width:fit-content}
.tab{padding:8px 20px;border-radius:7px;font-size:13px;font-weight:600;cursor:pointer;color:var(--dim);transition:all .2s}
.tab.active{background:var(--s3);color:var(--text)}
.tab-content{display:none}.tab-content.active{display:block}
.code-card{background:var(--s1);border:1px solid var(--border);border-radius:12px;overflow:hidden}
.code-bar{background:var(--s2);border-bottom:1px solid var(--border);padding:10px 16px;display:flex;align-items:center;gap:8px}
.code-bar-title{font-family:var(--mono);font-size:12px;color:var(--dim2);margin-left:4px}
.copy-btn{margin-left:auto;background:var(--s3);border:1px solid var(--border);color:var(--dim);font-size:11px;padding:3px 10px;border-radius:5px;cursor:pointer;font-family:var(--mono);transition:color .2s}.copy-btn:hover{color:var(--text)}
pre{font-family:var(--mono);font-size:13px;padding:20px;overflow-x:auto;line-height:1.75;color:var(--text)}
.cm{color:var(--dim2)}.ck{color:#f97316}.cs{color:#A5D6FF}.cv{color:var(--green)}.ce{color:var(--electric)}.cp{color:var(--purple)}
/* ENTERPRISE CTA */
.enterprise{padding:80px 40px;max-width:1280px;margin:0 auto}
.ent-card{background:linear-gradient(135deg,rgba(139,92,246,.12) 0%,rgba(6,182,212,.08) 100%);border:1px solid rgba(139,92,246,.3);border-radius:20px;padding:60px 48px;text-align:center;position:relative;overflow:hidden}
.ent-card::before{content:'';position:absolute;top:-100px;right:-100px;width:400px;height:400px;background:radial-gradient(circle,rgba(139,92,246,.15) 0%,transparent 70%);pointer-events:none}
.ent-eyebrow{font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--purple);margin-bottom:16px}
.ent-h2{font-size:clamp(28px,4vw,44px);font-weight:800;letter-spacing:-1px;margin-bottom:16px}
.ent-sub{font-size:17px;color:var(--dim);max-width:600px;margin:0 auto 40px;line-height:1.7}
.ent-btns{display:flex;justify-content:center;gap:14px;flex-wrap:wrap}
.ent-features{display:flex;justify-content:center;flex-wrap:wrap;gap:12px;margin-top:36px}
.ent-feat{display:flex;align-items:center;gap:6px;font-size:13px;color:var(--dim)}
.ent-feat::before{content:'✓';color:var(--green);font-weight:700}
/* FOOTER */
footer{border-top:1px solid var(--border);padding:40px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:16px;max-width:1280px;margin:0 auto}
.footer-brand{font-family:var(--mono);font-size:14px;color:var(--dim)}.footer-brand a{color:var(--electric)}
.footer-links{display:flex;gap:24px;flex-wrap:wrap}
.footer-links a{font-size:13px;color:var(--dim);transition:color .2s}.footer-links a:hover{color:var(--text)}
/* ANIM UTILS */
@keyframes fade-in{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
.fade-in{animation:fade-in .5s ease forwards}
@keyframes shimmer{0%{background-position:-200% center}100%{background-position:200% center}}
/* RESPONSIVE */
@media(max-width:900px){
  .terminal-stage{grid-template-columns:1fr}
  nav{padding:0 20px}.nav-links{display:none}
  .hero{padding:70px 20px 60px}
  .demo-section,.features,.comparison,.deploy,.enterprise,.footer{padding-left:20px;padding-right:20px}
  .hero-stats{flex-wrap:wrap}.hs{flex:1;min-width:140px}
  .ent-card{padding:40px 24px}
}
</style>
</head>
<body>

<!-- ── NAV ─────────────────────────────────────────────────────── -->
<nav>
  <span class="nav-logo">⚡ FlashAgent</span>
  <div class="nav-links">
    <a href="#demo">Demo</a>
    <a href="#features">Features</a>
